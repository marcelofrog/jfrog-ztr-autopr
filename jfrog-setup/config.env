# Configuration for jfrog-setup/setup.sh, teardown.sh and local-build.sh. Edit, or override with environment variables.
#
# Instance values (JFROG_FQDN, JFROG_SERVER_ID) are secrets: they live in the root .env, which is
# git-ignored and loaded below. A variable already set in the environment wins over .env.

# Load the root .env into the environment, without overriding variables that are already set.
_root_env="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/.env"
if [[ -f "$_root_env" ]]; then
  while IFS= read -r _line || [[ -n "$_line" ]]; do
    [[ "$_line" =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)= ]] || continue
    _name="${BASH_REMATCH[1]}"
    [[ -n "${!_name+x}" ]] && continue
    eval "export $_line"
  done < "$_root_env"
fi
unset _root_env _line _name

# REQUIRED. Where the JFrog Platform lives and how the JFrog CLI knows it. Nothing else in these
# scripts (or in the README commands) hardcodes a host or a server id: they all come from here.
#   JFROG_FQDN       host name of the instance, no scheme or slash (e.g. acme.jfrog.io)
#   JFROG_SERVER_ID  the instance name in the JFrog CLI (the "Server ID" in `jf c show`)
# Authentication is whatever the CLI has for that server (`jf login`): no tokens are configured here.
JFROG_FQDN="${JFROG_FQDN:-}"
JFROG_SERVER_ID="${JFROG_SERVER_ID:-}"

# JFrog Project. PROJECT_KEY and PROJECT_NAME are set in the root .env. 2-32 lowercase alphanumerics.
# Every repository is prefixed
# "<PROJECT_KEY>-", which Artifactory requires for project-scoped repositories.
PROJECT_KEY="${PROJECT_KEY:-javasample}"
PROJECT_NAME="${PROJECT_NAME:-Java Sample}"

# New user created and made Project Admin of the project.
PROJECT_ADMIN_USER="${PROJECT_ADMIN_USER:-javasample-admin}"
PROJECT_ADMIN_EMAIL="${PROJECT_ADMIN_EMAIL:-javasample-admin@example.com}"
PROJECT_ADMIN_PASSWORD="${PROJECT_ADMIN_PASSWORD:-}"   # empty = generate one and print it

# AppTrust application (belongs to the project above). APP_KEY and APP_NAME are set in the root .env.
APP_KEY="${APP_KEY:-sample-app}"
APP_NAME="${APP_NAME:-Sample App}"
APP_DESCRIPTION="${APP_DESCRIPTION:-Lean Java/Maven sample service}"
APP_CRITICALITY="${APP_CRITICALITY:-low}"           # unspecified|low|medium|high|critical
APP_MATURITY="${APP_MATURITY:-experimental}"        # unspecified|experimental|production|end_of_life

# GitHub Actions OIDC. GITHUB_REPOSITORY ("owner/repo") is the only workflow allowed to
# exchange its OIDC token for a JFrog token. REQUIRED for setup.sh.
GITHUB_REPOSITORY="${GITHUB_REPOSITORY:-}"
OIDC_PROVIDER_NAME="${OIDC_PROVIDER_NAME:-github-actions}"
OIDC_ISSUER_URL="${OIDC_ISSUER_URL:-https://token.actions.githubusercontent.com}"
OIDC_AUDIENCE="${OIDC_AUDIENCE:-jfrog-github}"      # must match `oidc-audience` in ci.yml
OIDC_MAPPING_NAME="${OIDC_MAPPING_NAME:-github-ci}"
CI_TOKEN_USERNAME="${CI_TOKEN_USERNAME:-github-ci}" # subject of the short-lived CI tokens
CI_PROJECT_ROLE="${CI_PROJECT_ROLE:-Developer}"     # project role granted to CI tokens
CI_TOKEN_TTL_SECONDS="${CI_TOKEN_TTL_SECONDS:-3600}"

# Upstreams proxied by the remote repositories.
MAVEN_UPSTREAM_URL="${MAVEN_UPSTREAM_URL:-https://repo1.maven.org/maven2}"
DOCKER_UPSTREAM_URL="${DOCKER_UPSTREAM_URL:-https://registry-1.docker.io}"

# Environments the local repositories are assigned to (used by AppTrust promotion).
# Set to "" to skip environment assignment.
DEV_ENVIRONMENT="${DEV_ENVIRONMENT:-DEV}"
PROD_ENVIRONMENT="${PROD_ENVIRONMENT:-PROD}"
