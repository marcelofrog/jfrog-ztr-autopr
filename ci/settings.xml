<?xml version="1.0" encoding="UTF-8"?>
<!--
  Routes ALL Maven resolution (dependencies and plugins) through the JFrog virtual repo.
  Required env: JF_URL (no trailing slash), JF_MAVEN_REPO, JF_USER, JF_ACCESS_TOKEN.
  Usage: mvn -s ci/settings.xml verify
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <servers>
    <server>
      <id>jfrog</id>
      <username>${env.JF_USER}</username>
      <password>${env.JF_ACCESS_TOKEN}</password>
    </server>
  </servers>
  <mirrors>
    <mirror>
      <id>jfrog</id>
      <mirrorOf>*</mirrorOf>
      <url>${env.JF_URL}/artifactory/${env.JF_MAVEN_REPO}</url>
    </mirror>
  </mirrors>
</settings>
