# TEMPLATE for the JFrog setup. Committed. Copy it and fill it in:
#   cp .env.sample .env
# .env (not this file) is git-ignored and holds your real values; never commit it.
#
# Instance secrets and names for the JFrog setup.
# Loaded by jfrog-setup/config.env. A variable already set in the environment overrides the value here.

# JFrog Platform host, no scheme or slash (e.g. acme.jfrog.io)
JFROG_FQDN=

# JFrog CLI server id for that host (the "Server ID" shown by `jf c show`)
JFROG_SERVER_ID=

# JFrog Project (2-32 lowercase alphanumerics; repositories are prefixed with the key)
PROJECT_KEY=javasample
PROJECT_NAME="Java Sample"

# AppTrust application
APP_KEY=sample-app
APP_NAME="Sample App"

# Optional: a fixed project admin password instead of a generated one (setup.sh prints a generated one once)
# PROJECT_ADMIN_PASSWORD=
