# TEMPLATE for the JFrog setup. Committed. Copy it and fill it in:
#   cp .env.sample .env
# .env (not this file) is git-ignored and holds your real values; never commit it.
#
# Instance secrets and names for the JFrog setup.
# Always loaded by every script via jfrog-setup/config.env. A KEY=value line here overrides the same variable
# in your shell environment. To use the environment instead, delete or comment out the line.

# JFrog Platform host, no scheme or slash (e.g. acme.jfrog.io)
JFROG_FQDN=

# JFrog CLI server id for that host (the "Server ID" shown by `jf c show`)
JFROG_SERVER_ID=

# JFrog Project (2-32 lowercase alphanumerics; repositories are prefixed with the key)
PROJECT_KEY=javasample
PROJECT_NAME="Java Sample"

# Project admin user created by setup.sh (username)
PROJECT_ADMIN_USER=javasample-admin

# AppTrust application
APP_KEY=sample-app
APP_NAME="Sample App"

# GitHub repository allowed to exchange its OIDC token for JFrog tokens ("owner/repo", e.g. acme/my-app)
GITHUB_REPOSITORY=

# OIDC provider name and audience for the GitHub OIDC token exchange
OIDC_PROVIDER_NAME=
OIDC_AUDIENCE=

# GitHub organization (or user) that owns the repo. Case-sensitive; JFrog requires it for the GitHub OIDC
# provider. Leave empty to use the owner part of GITHUB_REPOSITORY.
GITHUB_ORG=

# Optional: Xray indexes builds in <PROJECT_KEY>-build-info by build name pattern ("*/**" = every build of the project)
#BUILD_INDEX_PATTERN=*/**

# Optional: a fixed project admin password instead of a generated one (setup.sh prints a generated one once)
# PROJECT_ADMIN_PASSWORD=

# Optional. setup.sh writes these when `java` or `mvn` is not on PATH.
# M2_HOME is the Maven install directory: it contains bin and lib. JAVA_HOME is the JDK.
# M2_HOME=
# JAVA_HOME=
